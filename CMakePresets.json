{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "native-debug",
      "displayName": "Native Debug (+ ASan/UBSan on Linux/macOS)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AUD_BUILD_TESTS": "ON",
        "AUD_BUILD_CLI": "ON",
        "AUD_BUILD_WASM": "OFF",
        "AUD_ENABLE_ASAN": true
      }
    },
    {
      "name": "native-release",
      "displayName": "Native Release (benchmarks)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AUD_BUILD_TESTS": "ON",
        "AUD_BUILD_CLI": "ON",
        "AUD_BUILD_WASM": "OFF"
      }
    },
    {
      "name": "wasm-debug",
      "displayName": "WASM Debug (DWARF, assertions, no closure)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm-debug",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AUD_BUILD_TESTS": "OFF",
        "AUD_BUILD_CLI": "OFF",
        "AUD_BUILD_WASM": "ON"
      }
    },
    {
      "name": "wasm-profile",
      "displayName": "WASM Profile (--profiling-funcs, symbol names kept)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm-profile",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "AUD_BUILD_TESTS": "OFF",
        "AUD_BUILD_CLI": "OFF",
        "AUD_BUILD_WASM": "ON",
        "AUD_ENABLE_PROFILING": true
      }
    },
    {
      "name": "wasm-release",
      "displayName": "WASM Release (closure, no assertions, -O3)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm-release",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AUD_BUILD_TESTS": "OFF",
        "AUD_BUILD_CLI": "OFF",
        "AUD_BUILD_WASM": "ON"
      }
    },
    {
      "name": "wasm-test",
      "displayName": "WASM Test (release + node in -sENVIRONMENT, for tests/integration only)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm-test",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AUD_BUILD_TESTS": "OFF",
        "AUD_BUILD_CLI": "OFF",
        "AUD_BUILD_WASM": "ON",
        "AUD_WASM_FOR_NODE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "native-debug", "configurePreset": "native-debug" },
    { "name": "native-release", "configurePreset": "native-release" },
    { "name": "wasm-debug", "configurePreset": "wasm-debug" },
    { "name": "wasm-profile", "configurePreset": "wasm-profile" },
    { "name": "wasm-release", "configurePreset": "wasm-release" },
    { "name": "wasm-test", "configurePreset": "wasm-test" }
  ],
  "testPresets": [
    { "name": "native-debug", "configurePreset": "native-debug", "output": { "outputOnFailure": true } },
    { "name": "native-release", "configurePreset": "native-release", "output": { "outputOnFailure": true } }
  ]
}
